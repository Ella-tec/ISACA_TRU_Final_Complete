@page "/governance"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Governance & Policies | TRU</PageTitle>

<style>
.gov{--navy:#1d2d5c;--purple:#5b4b8a;--mid:#3d4f8c;--blue:#07649d;--muted:#5f6b85;--line:#e2e8f0;--light:#f0eef8;
font-family:"Roboto",system-ui,sans-serif;color:var(--navy);width:100%;max-width:none;margin:0;padding:12px;box-sizing:border-box}
.gov-hero{border-radius:18px;padding:1.5rem 1.75rem;color:#fff;margin-bottom:1rem;
background:linear-gradient(115deg,#4a3f7a 0%,#2c3e6b 55%,#0a3d6b 100%);box-shadow:0 14px 36px rgba(45,40,90,.2)}
.gov-hero h1{margin:.2rem 0 .35rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.75rem}
.gov-hero p{margin:0;opacity:.92;max-width:52ch;line-height:1.45}
.gov-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem;margin-bottom:.75rem}
.gov-kpi{background:#fff;border-radius:14px;padding:1rem;border:1px solid var(--line);box-shadow:0 6px 18px rgba(29,45,92,.06);
cursor:pointer;text-align:left;font-family:inherit;color:inherit;transition:border-color .12s,box-shadow .12s}
.gov-kpi:hover{border-color:#9b8fd4}.gov-kpi.on{border-color:#6b5b9a;box-shadow:0 0 0 2px rgba(107,91,154,.25)}
.gov-kpi .l{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.gov-kpi .v{font-size:1.5rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;margin:.15rem 0}
.gov-kpi .t{font-size:.78rem;color:var(--muted)}
.gov-detail{background:#f0eef8;border-radius:14px;padding:1rem 1.2rem;margin-bottom:1rem;border:1px solid #d5d0ea;font-size:.9rem;line-height:1.45}
.gov-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:.7rem}
.gov-card{background:#fff;border-radius:14px;padding:1rem 1.1rem;border:1px solid var(--line);box-shadow:0 6px 18px rgba(29,45,92,.05)}
.gov-card h2{margin:0 0 .2rem;font-size:1.05rem}.gov-card .sub{margin:0 0 .75rem;font-size:.82rem;color:var(--muted)}
.gov-search{width:100%;box-sizing:border-box;padding:.5rem .75rem;border-radius:999px;border:1.5px solid var(--line);margin-bottom:.75rem;font:inherit}
.gov-row{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.7rem 0;border-bottom:1px solid #f1f5f9}
.gov-row:last-child{border-bottom:none}
.gov-row strong{display:block}.gov-row small{color:var(--muted);font-size:.8rem}
.gov-btn{border:none;border-radius:10px;padding:.4rem .85rem;font-weight:700;font-size:.8rem;cursor:pointer;font-family:inherit;background:#3d3a6b;color:#fff}
.gov-btn-g{background:#e8e6f4;color:#3d3a6b}
.gov-cal-row{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.65rem 0;border-bottom:1px solid #f1f5f9}
.gov-cal-row:last-child{border-bottom:none}
.gov-bars{display:flex;align-items:flex-end;gap:8px;height:90px;margin:.5rem 0 1rem}
.gov-bar{flex:1;background:linear-gradient(180deg,#7c6fb5,#4a3f7a);border-radius:6px 6px 2px 2px;border:none;cursor:pointer;min-height:10px}
@@media(max-width:900px){.gov-kpis{grid-template-columns:1fr 1fr}.gov-grid{grid-template-columns:1fr}}
</style>

<section class="gov">
    <header class="gov-hero">
        <div style="font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.85">TRUST & COMPLIANCE</div>
        <h1>Governance & policies</h1>
        <p>Policy register and review calendar — every metric is a button. Charts and rows open detail and actions.</p>
    </header>

    <div class="gov-kpis">
        <button type="button" class="gov-kpi @(focus=="all"?"on":null)" @onclick='() => SetFocus("all")'>
            <div class="l">Policy records</div><div class="v">@total</div><div class="t">In register →</div>
        </button>
        <button type="button" class="gov-kpi @(focus=="ok"?"on":null)" @onclick='() => SetFocus("ok")'>
            <div class="l">Approved</div><div class="v">@approved</div><div class="t">Current →</div>
        </button>
        <button type="button" class="gov-kpi @(focus=="rev"?"on":null)" @onclick='() => SetFocus("rev")'>
            <div class="l">Needs review</div><div class="v">@needs</div><div class="t">Action →</div>
        </button>
        <button type="button" class="gov-kpi @(focus=="next"?"on":null)" @onclick='() => SetFocus("next")'>
            <div class="l">Next review</div><div class="v">@nextLabel</div><div class="t">@nextYear →</div>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(detail))
    {
        <div class="gov-detail">
            <div>@detail</div>
            <div style="margin-top:.65rem;display:flex;flex-wrap:wrap;gap:.4rem">
                @if (selectedPolicy is not null)
                {
                    <button type="button" class="gov-btn" @onclick="OpenIsacaForSelected">Open ISACA resource</button>
                    <button type="button" class="gov-btn gov-btn-g" @onclick="MarkReviewed">Mark approved</button>
                }
                <a class="gov-btn" style="text-decoration:none" href="https://www.isaca.org/resources" target="_blank" rel="noopener">ISACA Resources</a>
                <a class="gov-btn" style="text-decoration:none" href="https://www.isaca.org/resources/cobit" target="_blank" rel="noopener">COBIT</a>
                <a class="gov-btn gov-btn-g" style="text-decoration:none" href="/events">Plan on Events</a>
            </div>
        </div>
    }

    <div class="gov-grid">
        <article class="gov-card">
            <h2>Policy register</h2>
            <p class="sub">Filter and open policies</p>
            <input class="gov-search" @bind="search" @bind:event="oninput" placeholder="Search policies..." />
            @foreach (var p in Filtered)
            {
                <div class="gov-row">
                    <div>
                        <strong>@p.Title</strong>
                        <small>@p.Owner · @p.Status</small>
                    </div>
                    <button type="button" class="gov-btn" @onclick="() => OpenPolicy(p)">Open</button>
                </div>
            }
        </article>
        <article class="gov-card">
            <h2>Review calendar</h2>
            <p class="sub">Upcoming policy reviews</p>
            <div class="gov-bars">
                @foreach (var q in quarters)
                {
                    <button type="button" class="gov-bar" style="height:@q.H%" @onclick="() => ShowQuarter(q)" title="@q.Label"></button>
                }
            </div>
            @foreach (var c in calendar)
            {
                <div class="gov-cal-row">
                    <div>
                        <strong style="color:#3d3a6b">@c.Title</strong>
                        <div style="font-size:.8rem;color:var(--muted)">@c.When · @c.Owner</div>
                    </div>
                    <button type="button" class="gov-btn gov-btn-g" @onclick="() => Plan(c)">Plan</button>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private string focus = "all";
    private string detail = "";
    private string search = "";
    private string nextLabel = "Nov";
    private string nextYear = "2026";
    private Policy? selectedPolicy;

    private sealed class Policy
    {
        public string Title { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Status { get; set; } = "";
    }
    private sealed class CalItem { public string Title { get; set; } = ""; public string When { get; set; } = ""; public string Owner { get; set; } = ""; }
    private sealed class Quarter { public string Label { get; set; } = ""; public int H { get; set; } public string Note { get; set; } = ""; }
    private sealed class Check { public string Text { get; set; } = ""; }

    private List<Policy> policies = new();
    private List<CalItem> calendar = new();
    private List<Quarter> quarters = new();
    private List<Check> checks = new();

    private int total => policies.Count;
    private int approved => policies.Count(p => p.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase));
    private int needs => policies.Count(p => p.Status.Contains("review", StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Policy> Filtered => policies.Where(p =>
        string.IsNullOrWhiteSpace(search)
        || p.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
        || p.Owner.Contains(search, StringComparison.OrdinalIgnoreCase)
        || p.Status.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        policies = new List<Policy>
        {
            new() { Title = "Knowledge content approval", Owner = "Content team", Status = "In review" },
            new() { Title = "Support escalation procedure", Owner = "Chapter operations", Status = "Approved" },
            new() { Title = "Access and role management", Owner = "Administrator", Status = "Approved" },
            new() { Title = "AI answer quality review", Owner = "AI project team", Status = "Needs review" },
            new() { Title = "Board officer handbook", Owner = "Board", Status = "Approved" },
        };
        calendar = new List<CalItem>
        {
            new() { Title = "Access and role management", When = "Nov 2026", Owner = "Administrator" },
            new() { Title = "Support escalation procedure", When = "Dec 2026", Owner = "Chapter operations" },
            new() { Title = "AI answer quality review", When = "Dec 2026", Owner = "AI project team" },
            new() { Title = "Knowledge content approval", When = "Jan 2027", Owner = "Content team" },
        };
        quarters = new List<Quarter>
        {
            new() { Label = "Q1", H = 55, Note = "Board handbook cycle" },
            new() { Label = "Q2", H = 40, Note = "Light review load" },
            new() { Label = "Q3", H = 70, Note = "Escalation + access" },
            new() { Label = "Q4", H = 90, Note = "AI + knowledge peak" },
        };
        checks = new List<Check>
        {
            new() { Text = "Confirm the source is authoritative" },
            new() { Text = "Assign a policy owner" },
            new() { Text = "Record approval and review dates" },
            new() { Text = "Check links and references" },
            new() { Text = "Schedule the next review" },
        };
        SetFocus("all");
    }

    private void SetFocus(string key)
    {
        focus = key;
        detail = key switch
        {
            "all" => $"Policy register contains {total} records. Use search and Open to review ownership and status.",
            "ok" => $"{approved} policies are Approved. Keep evidence of last review date in the register.",
            "rev" => $"{needs} policies need review (In review or Needs review). Prioritize AI answer quality and knowledge approval.",
            "next" => $"Next scheduled review window starts {nextLabel} {nextYear} (Access and role management).",
            _ => ""
        };
    }

    private void OpenPolicy(Policy p)
    {
        focus = p.Status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "rev" : "ok";
        var isaca = PolicyIsacaLink(p.Title);
        detail = $"Opened: {p.Title} — Owner: {p.Owner}, Status: {p.Status}. Related ISACA guidance available below.";
        selectedPolicy = p;
    }

    private async Task OpenIsacaForSelected()
    {
        if (selectedPolicy is null) return;
        var url = PolicyIsacaLink(selectedPolicy.Title);
        if (string.IsNullOrEmpty(url)) url = "https://www.isaca.org/resources";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void MarkReviewed()
    {
        if (selectedPolicy is null) return;
        selectedPolicy.Status = "Approved";
        detail = $"{selectedPolicy.Title} marked Approved. Schedule the next annual review.";
        SetFocus("ok");
    }

    private void Plan(CalItem c)
    {
        detail = $"Planned review: {c.Title} ({c.When}) — Owner {c.Owner}. Open Events to put it on the chapter calendar, or use ISACA resources for the framework.";
        selectedPolicy = policies.FirstOrDefault(p => p.Title == c.Title);
    }

    private void ShowQuarter(Quarter q)
    {
        detail = $"{q.Label} review load: {q.Note} (relative chart height {q.H}%).";
    }

    private static string PolicyIsacaLink(string title)
    {
        var t = title.ToLowerInvariant();
        if (t.Contains("access") || t.Contains("role")) return "https://www.isaca.org/resources/cobit";
        if (t.Contains("escalation") || t.Contains("support")) return "https://www.isaca.org/resources";
        if (t.Contains("ai") || t.Contains("answer")) return "https://www.isaca.org/resources/white-papers/2025/leveraging-cobit-for-effective-ai-system-governance";
        if (t.Contains("knowledge") || t.Contains("content")) return "https://www.isaca.org/resources";
        if (t.Contains("board") || t.Contains("handbook")) return "https://www.isaca.org/chapters";
        return "https://www.isaca.org/resources";
    }
}
